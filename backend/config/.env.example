# ============================================================================
# SIMPLIFIED BEDROCK KB CONFIGURATION
# ============================================================================
# Direct S3 → Bedrock KB flow with automatic metadata extraction
# No Lambda, No Step Functions, No SQS, No OpenSearch setup required!
# ============================================================================

# AWS Credentials (REQUIRED)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# S3 Storage (REQUIRED)
S3_RAW_BUCKET=dialog-telecom

# Bedrock Knowledge Base (REQUIRED)
# Get these from AWS Bedrock Console after creating your Knowledge Base
BEDROCK_KB_ID=your-knowledge-base-id
BEDROCK_DATA_SOURCE_ID=your-data-source-id
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# Bedrock Generation Model (for retrieve-and-generate)
# Claude Sonnet 4.5 via global inference profile
BEDROCK_GENERATION_MODEL_ARN=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Retrieval settings
KB_NUM_RESULTS=10

# Google Drive Integration (OPTIONAL - only if using Google Drive)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Scheduled Incremental Sync
# SYNC_INTERVAL_MINUTES — how often APScheduler runs the sync
#                         default: 60 (1 hour), set to 1 for local testing
# USE_EVENTBRIDGE       — set true in production to disable APScheduler
#                         and let AWS EventBridge trigger /api/kb/incremental-sync
SYNC_INTERVAL_MINUTES=60
USE_EVENTBRIDGE=false

# ============================================================================
# SETUP INSTRUCTIONS:
# ============================================================================
# 1. Create S3 bucket: aws s3 mb s3://your-kb-bucket-name
# 2. Create Bedrock Knowledge Base in AWS Console
# 3. Add S3 bucket as data source to Knowledge Base
# 4. Copy KB ID and Data Source ID to this file
# 5. Run: pip install -r requirements.txt
# 6. Run: python api/app.py
# ============================================================================
