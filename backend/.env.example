# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Buckets
S3_RAW_BUCKET=your-raw-bucket-name
S3_PROCESSED_BUCKET=your-processed-bucket-name

# Bedrock Configuration
BEDROCK_DATA_AUTOMATION_JOB_ARN=arn:aws:bedrock:region:account:data-automation-project/project-id
BEDROCK_KB_ID=your-knowledge-base-id
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# OpenSearch Configuration
OPENSEARCH_ENDPOINT=https://your-opensearch-domain.region.es.amazonaws.com
OPENSEARCH_INDEX=document-embeddings

# Step Functions
STEP_FUNCTION_ARN=arn:aws:states:region:account:stateMachine:ingestion-pipeline

# SQS Configuration
SQS_DLQ_URL=https://sqs.region.amazonaws.com/account/ingestion-dlq
SQS_RETRY_QUEUE_URL=https://sqs.region.amazonaws.com/account/ingestion-retry

# CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/ingestion-pipeline
ALARM_SNS_TOPIC_ARN=arn:aws:sns:region:account:ingestion-alarms

# Application Settings
MAX_RETRY_ATTEMPTS=3
CHUNK_SIZE=512
CHUNK_OVERLAP=50
